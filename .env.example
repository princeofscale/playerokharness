# PlayerOK Harness (pkh) — Environment Variables Example
# Copy to .env or inject via Docker Secrets / systemd EnvironmentFile.
# Any PKH_* variable overrides the corresponding field in bot_settings/config.json at runtime.

# Telegram Bot API
PKH_TELEGRAM_TOKEN=
PKH_TELEGRAM_API_URL=
PKH_TELEGRAM_PROXY=

# PlayerOK Session
PKH_PLAYEROK_COOKIES=
PKH_PLAYEROK_PROXY=
PKH_PLAYEROK_USER_AGENT=

# Read-only web dashboard (node:http, no extra dependencies).
# Set PKH_WEB_ENABLED=true (or pass --web) to start it. Bound to 127.0.0.1 by default;
# a non-loopback host REFUSES to start without PKH_WEB_TOKEN.
PKH_WEB_ENABLED=false
PKH_WEB_HOST=127.0.0.1
PKH_WEB_PORT=8787
PKH_WEB_TOKEN=

# Paths (optional)
PKH_DATA_DIR=.
PKH_PLUGINS_DIR=./plugins

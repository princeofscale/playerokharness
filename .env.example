# PlayerOK Harness (pkh) — Environment Variables Example
# Copy to .env or inject via Docker Secrets / systemd EnvironmentFile.
# Any PKH_* variable overrides the corresponding field in bot_settings/config.json at runtime.

# Telegram Bot API
PKH_TELEGRAM_TOKEN=
PKH_TELEGRAM_API_URL=
PKH_TELEGRAM_PROXY=

# PlayerOK Session
PKH_PLAYEROK_COOKIES=
PKH_PLAYEROK_PROXY=
PKH_PLAYEROK_USER_AGENT=

# Paths (optional)
PKH_DATA_DIR=.
PKH_PLUGINS_DIR=./plugins

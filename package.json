{
  "name": "playerokharness",
  "version": "1.0.0",
  "description": "Modular PlayerOK automation harness powered by Cordis 4, TypeScript, grammY, and Zod",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/princeofscale/playerokharness.git"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r --sort typecheck",
    "lint": "eslint packages test",
    "pretest": "pnpm -r --sort build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx packages/app/src/cli.ts",
    "pkh": "node packages/app/dist/cli.js",
    "start": "node packages/app/dist/cli.js start",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.15.0",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.0"
  }
}

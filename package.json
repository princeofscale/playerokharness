{
  "name": "playerok-universal-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx packages/app/src/cli.ts",
    "start": "node packages/app/dist/cli.js",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
